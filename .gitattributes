# Word files are binary: never line-ending convert or attempt to merge them.
# The repo had no .gitattributes and has already produced CRLF warnings on text
# files, so this is explicit rather than relying on git's auto-detection.
*.docx  binary
*.dotx  binary
*.doc   binary
*.dot   binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf

# The exploded master is the reviewable artifact - keep it diffable.
_tool/templates/master/**  text eol=lf
